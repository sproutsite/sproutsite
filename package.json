{
    "name": "sproutsite",
    "version": "0.5.37",
    "license": "Apache-2.0",
    "author": "Björn Hempel",
    "description": "Agent-first Static CMS powered by Astro and TypeScript, with Markdown-first content.",
    "homepage": "https://sproutsite.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/sproutsite/sproutsite.git"
    },
    "type": "module",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "files": [
        "src/lib/sproutsite/",
        "src/package/",
        "src/themes/default/",
        "README.md",
        "VERSION",
        "LICENSE",
        "NOTICE",
        "THIRD_PARTY_NOTICES.md",
        "third-party-licenses/"
    ],
    "exports": {
        ".": "./src/package/index.ts",
        "./content": "./src/package/content.ts",
        "./config": "./src/package/config.ts",
        "./components": "./src/package/components.ts",
        "./starter-assets": "./src/package/starter-assets/manifest.json",
        "./page": "./src/package/page.astro",
        "./package.json": "./package.json",
        "./themes": "./src/package/themes.ts",
        "./default-components": "./src/package/default-components.ts"
    },
    "imports": {
        "#sproutsite/header": "./src/themes/default/components/organisms/Header/Header.astro",
        "#sproutsite/footer": "./src/themes/default/components/organisms/Footer/Footer.astro",
        "#sproutsite/layout": "./src/themes/default/layouts/ThemeLayout/ThemeLayout.astro",
        "#sproutsite/alert": "./src/themes/default/components/molecules/Alert/Alert.astro",
        "#sproutsite/contenttable": "./src/themes/default/components/molecules/ContentTable/ContentTable.astro",
        "#sproutsite/foundationsample": "./src/themes/default/components/molecules/FoundationSample/FoundationSample.astro",
        "#sproutsite/tabs": "./src/themes/default/components/molecules/Tabs/Tabs.astro",
        "#sproutsite/tab": "./src/themes/default/components/atoms/Tab/Tab.astro",
        "#sproutsite/card": "./src/themes/default/components/molecules/Card/Card.astro",
        "#sproutsite/cardactions": "./src/themes/default/components/molecules/CardActions/CardActions.astro",
        "#sproutsite/contentimage": "./src/themes/default/components/atoms/ContentImage/ContentImage.astro",
        "#sproutsite/eyebrow": "./src/themes/default/components/atoms/Eyebrow/Eyebrow.astro",
        "#sproutsite/badge": "./src/themes/default/components/atoms/Badge/Badge.astro",
        "#sproutsite/button": "./src/themes/default/components/atoms/Button/Button.astro",
        "#sproutsite/icon": "./src/themes/default/components/atoms/Icon/Icon.astro",
        "#sproutsite/feature": "./src/themes/default/components/molecules/Feature/Feature.astro",
        "#sproutsite/legalidentity": "./src/themes/default/components/molecules/LegalIdentity/LegalIdentity.astro",
        "#sproutsite/privacyinfrastructure": "./src/themes/default/components/molecules/PrivacyInfrastructure/PrivacyInfrastructure.astro",
        "#sproutsite/accordion": "./src/themes/default/components/molecules/Accordion/Accordion.astro",
        "#sproutsite/accordionitem": "./src/themes/default/components/molecules/AccordionItem/AccordionItem.astro",
        "#sproutsite/column": "./src/themes/default/components/layout/Column/Column.astro",
        "#sproutsite/columns": "./src/themes/default/components/layout/Columns/Columns.astro",
        "#sproutsite/hero": "./src/themes/default/components/organisms/Hero/Hero.astro",
        "#sproutsite/pagetitle": "./src/themes/default/components/organisms/PageTitle/PageTitle.astro",
        "#sproutsite/section": "./src/themes/default/components/organisms/Section/Section.astro",
        "#sproutsite/blogindex": "./src/themes/default/components/organisms/BlogIndex/BlogIndex.astro",
        "#sproutsite/blogpost": "./src/themes/default/components/organisms/BlogPost/BlogPost.astro",
        "#sproutsite/errorpage": "./src/themes/default/layouts/ErrorPage/ErrorPage.astro",
        "#sproutsite/brandlogo": "./src/themes/default/components/atoms/BrandLogo/BrandLogo.astro",
        "#sproutsite/herobackground": "./src/themes/default/components/atoms/HeroBackground/HeroBackground.astro",
        "#sproutsite/languageswitcher": "./src/themes/default/components/molecules/LanguageSwitcher/LanguageSwitcher.astro",
        "#sproutsite/document": "./src/package/Document.astro"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "overrides": {
        "postcss-selector-parser": "6.1.5"
    },
    "scripts": {
        "branding:generate": "node --import tsx scripts/generate-branding.ts && npm run starter-assets:generate",
        "starter-assets:generate": "node --import tsx scripts/generate-starter-assets.ts",
        "dev": "astro dev --force",
        "dev:starter": "node --import tsx scripts/starter.ts dev",
        "build:starter": "node --import tsx scripts/starter.ts build",
        "test:starter": "node --import tsx scripts/starter.ts test",
        "build": "npm run validate && astro build && node --import tsx scripts/verify-build.ts",
        "build:demo": "SPROUTSITE_BASE=/demo/ npm run build",
        "export:mcp": "npm run validate && astro build --config astro.mcp.config.ts && node --import tsx scripts/verify-mcp-export.ts",
        "preview": "astro preview",
        "check": "npm run validate && astro check",
        "validate": "node --import tsx scripts/validate-content.ts",
        "test": "node --import tsx --test tests/**/*.test.ts",
        "test:a11y": "npm run build && node --import tsx scripts/test-a11y.ts",
        "test:source": "node --import tsx scripts/check-source-files.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pack:check": "npm pack --dry-run",
        "test:package": "node --import tsx scripts/test-package.ts",
        "prepublishOnly": "npm run format:check && npm run test:source && npm run check && npm test && npm run build && npm run test:package",
        "storybook": "storybook dev --port 6006",
        "build:storybook": "storybook build"
    },
    "peerDependencies": {
        "@astrojs/mdx": "^8.1.6",
        "astro": "^7.4.12"
    },
    "dependencies": {
        "@astrojs/markdown-remark": "^7.3.9",
        "@astrojs/sitemap": "^3.7.4",
        "@lucide/astro": "^1.73.0",
        "@shikijs/langs": "^4.5.0",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "daisyui": "^5.7.42",
        "flag-icons": "^7.6.0",
        "github-slugger": "^2.0.0",
        "remark-gfm": "^4.0.1",
        "remark-mdx": "^3.1.1",
        "remark-parse": "^11.0.0",
        "simple-icons": "^16.38.0",
        "tailwindcss": "^4.3.3",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "yaml": "^2.9.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/mdx": "^8.1.6",
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@storybook-astro/framework": "^1.15.0",
        "@storybook/addon-docs": "^10.6.6",
        "@storybook/builder-vite": "^10.6.6",
        "@types/fontkit": "^2.0.9",
        "astro": "^7.4.12",
        "axe-core": "^4.13.0",
        "fontkit": "^2.0.4",
        "hast-util-from-html": "^2.1.0",
        "pagefind": "1.6.0",
        "playwright": "^1.63.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "remark-stringify": "^11.0.0",
        "sharp": "^0.35.5",
        "storybook": "^10.6.6",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
