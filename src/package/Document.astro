---
import './styles.css';
import Header from '#sproutsite/header';
import Footer from '#sproutsite/footer';
import type { SiteConfig } from '../lib/sproutsite/types.js';
import { canonicalUrl, withBase } from '../lib/sproutsite/urls.js';
import { resolveBranding } from './branding.js';
import Layout from '#sproutsite/layout';
import { paletteStyles as themePaletteStyles } from 'virtual:sproutsite/theme';
interface Props {
    site: SiteConfig;
    title: string;
    description: string;
    route: string;
    layout?: 'default' | 'landing';
    noindex?: boolean;
}
const {
    site,
    title,
    description,
    route,
    layout = 'default',
    noindex = false,
} = Astro.props;
const documentTitle = title.toLowerCase().includes(site.name.toLowerCase())
    ? title
    : `${title} | ${site.name}`;
const canonical = noindex
    ? new URL(withBase(route, site.base), site.url).href
    : canonicalUrl(route, site);
const branding = await resolveBranding(site);
const socialImage = branding.sharingImage;
const paletteStyles = themePaletteStyles(
    site.colors,
    `site configuration (${site.i18n.locale})`,
);
---

<!doctype html>
<html lang={site.i18n.locale} data-theme="sproutsite" style={paletteStyles}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{documentTitle}</title>
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex, follow" />}
        <link rel="canonical" href={canonical} />
        <link
            rel="sitemap"
            type="application/xml"
            href={withBase('/sitemap.xml', site.base)}
        />
        <link
            rel="icon"
            type={branding.favicon.type}
            href={branding.favicon.src}
        />
        {branding.shortcut && (
            <link rel="icon" type="image/x-icon" href={branding.shortcut} />
        )}
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href={branding.appleTouch}
        />
        <link rel="manifest" href={withBase('/site.webmanifest', site.base)} />
        <meta property="og:title" content={documentTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:type" content="website" />
        {socialImage && (
            <>
                <meta property="og:image" content={socialImage.src} />
                <meta
                    property="og:image:width"
                    content={String(socialImage.width)}
                />
                <meta
                    property="og:image:height"
                    content={String(socialImage.height)}
                />
                <meta property="og:image:alt" content={socialImage.alt} />
                <meta name="twitter:image" content={socialImage.src} />
                <meta name="twitter:image:alt" content={socialImage.alt} />
            </>
        )}
        <meta
            name="twitter:card"
            content={socialImage ? 'summary_large_image' : 'summary'}
        />
        <meta name="twitter:title" content={documentTitle} />
        <meta name="twitter:description" content={description} />
    </head>
    <body
        data-heading-font={site.typography.headings.family}
        data-eyebrow-font={site.typography.eyebrow.family}
        style={{
            '--ss-heading-weight': String(site.typography.headings.weight),
            '--ss-eyebrow-weight': String(site.typography.eyebrow.weight),
        }}
        class:list={{
            'ss-page--landing': layout === 'landing',
            'ss-links--external-icons': site.links?.external?.icon === true,
        }}
    >
        <a class="ss-skip-link" href="#main-content">
            {site.i18n.locale === 'de'
                ? 'Zum Inhalt springen'
                : 'Skip to content'}
        </a>
        <Layout site={site} route={route} layout={layout}>
            {layout !== 'landing' && <Header site={site} route={route} />}
            <main id="main-content">
                <slot />
            </main>
            <Footer site={site} route={route} />
        </Layout>
    </body>
</html>
