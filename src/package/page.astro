---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { assemblePages, type AssembledPage } from '../lib/sproutsite/pages.js';
import { loadSiteConfig } from '../lib/sproutsite/site-config.js';
import { blogRouteFromId } from '../lib/sproutsite/urls.js';
import { localeOf, logicalId } from '../lib/sproutsite/language-links.js';
import PageLayout from '#sproutsite/document';
import BlogIndex from '#sproutsite/blogindex';
import BlogPost from '#sproutsite/blogpost';
import Hero from '#sproutsite/hero';
import PageTitle from '#sproutsite/pagetitle';
import Section from '#sproutsite/section';
import { getBlogCollection } from './blog.js';
import { getImage } from 'astro:assets';

type Locale = 'en' | 'de';

export { localeOf, logicalId };

export async function getSproutsiteStaticPaths(
    locale: Locale = loadSiteConfig().i18n.defaultLocale as Locale,
) {
    if (!loadSiteConfig().i18n.locales.includes(locale)) return [];
    const pages = assemblePages(
        (await getCollection('pages')).filter(
            (entry) => localeOf(entry.id) === locale,
        ),
        (await getCollection('documents')).filter(
            (entry) => localeOf(entry.id) === locale,
        ),
        undefined,
        (entry) => logicalId(entry.id),
    );
    const pagePaths = pages.map((page) => ({
        params: {
            slug: page.route === '/' ? undefined : page.route.slice(1, -1),
        },
        props: { page, locale },
    }));
    const posts = (await getBlogCollection('blogPages'))
        .filter((entry) => localeOf(entry.id) === locale)
        .sort(
            (left, right) =>
                right.data.pubDate.getTime() - left.data.pubDate.getTime(),
        );
    const assembledPosts = assemblePages(
        posts,
        (await getBlogCollection('blogDocuments')).filter(
            (entry) => localeOf(entry.id) === locale,
        ),
        (entry) => blogRouteFromId(logicalId(entry.id)),
        (entry) => logicalId(entry.id),
    );
    const blogPaths = [
        {
            params: { slug: 'blog' },
            props: { blogIndex: true, posts, locale },
        },
        ...assembledPosts.map((post) => ({
            params: { slug: post.route.slice(1, -1) },
            props: { post, locale },
        })),
    ];
    return [...pagePaths, ...blogPaths];
}

interface Props {
    locale: Locale;
    page?: AssembledPage;
    blogIndex?: boolean;
    posts?: CollectionEntry<'blogPages'>[];
    post?: AssembledPage<
        CollectionEntry<'blogPages'>,
        CollectionEntry<'blogDocuments'>
    >;
}
const { page, blogIndex, posts, post, locale } = Astro.props;
const site = loadSiteConfig(locale);
const hero = page?.hero ? await render(page.hero) : undefined;
const sections = page
    ? await Promise.all(
          page.sections.map(async (section) => ({
              section,
              rendered: await render(section),
          })),
      )
    : [];
const postHero = post?.hero ? await render(post.hero) : undefined;
const postImage = post
    ? await getImage({
          src: post.entry.data.image,
          width: 1200,
          format: 'webp',
      })
    : undefined;
const postSections = post
    ? await Promise.all(
          post.sections.map(async (section) => ({
              section,
              Content: (await render(section)).Content,
          })),
      )
    : [];
---

{page ? (
    <PageLayout
        site={site}
        title={page.entry.data.title}
        description={page.entry.data.description}
        route={page.route}
        layout={page.entry.data.layout}
    >
        {hero ? (
            <Hero hero={page.hero!} site={site} Content={hero.Content} />
        ) : page.entry.data.layout !== 'landing' ? (
            <PageTitle
                site={site}
                title={page.entry.data.title}
                classes={site.hero.classes}
            />
        ) : null}
        {sections.map(({ section, rendered }) => (
            <Section section={section} Content={rendered.Content} />
        ))}
    </PageLayout>
) : blogIndex && posts ? (
    <PageLayout
        site={site}
        title={site.blog?.hero.title ?? 'Blog'}
        description={
            site.blog?.hero.description ??
            (locale === 'de'
                ? 'Neuigkeiten, Entscheidungen und Meilensteine.'
                : 'Updates, decisions, and milestones.')
        }
        route="/blog/"
    >
        <BlogIndex posts={posts} site={site} />
    </PageLayout>
) : post && postHero ? (
    <PageLayout
        site={site}
        title={post.entry.data.title}
        description={post.entry.data.description}
        route={post.route}
        article={{
            headline: post.hero?.data.title ?? post.entry.data.title,
            datePublished: post.entry.data.pubDate,
            image: postImage!.src,
            author: post.entry.data.author,
        }}
    >
        <BlogPost
            post={post}
            site={site}
            HeroContent={postHero.Content}
            sections={postSections}
        />
    </PageLayout>
) : null}
