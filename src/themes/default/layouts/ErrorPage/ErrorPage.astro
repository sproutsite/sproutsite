---
import Hero from '#sproutsite/hero';
import Section from '#sproutsite/section';
import Button from '#sproutsite/button';
import type { ErrorPageProps } from '../../../../package/theme-types.js';
type Props = ErrorPageProps;
const { status, site, copy } = Astro.props;
---

<Hero
    site={site}
    hero={{
        id: String(status),
        data: {
            title: copy.title,
            eyebrow: copy.eyebrow,
            type: 'small',
            tone: 'brand',
            fullWidth: false,
            spacing: 'default',
        },
    }}
>
    <p>{copy.introduction}</p>
</Hero>
<Section
    section={{
        id: '01-error-details',
        data: {
            tone: 'default',
            type: 'small',
            fullWidth: false,
            spacing: 'default',
        },
    }}
>
    <h2>{copy.sectionTitle}</h2>
    <p>{copy.description}</p>
    <p>{copy.detail}</p>
    <Button href="/" variant="primary">
        {copy.action}
    </Button>
</Section>
