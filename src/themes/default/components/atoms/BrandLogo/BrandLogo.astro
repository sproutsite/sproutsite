---
import type { SiteConfig } from '../../../../../lib/sproutsite/types.js';
import { withBase } from '../../../../../lib/sproutsite/urls.js';

interface Props {
    site: SiteConfig;
    placement?: 'header' | 'footer';
}
const { site, placement = 'header' } = Astro.props;
const { name } = site;
const logo =
    placement === 'footer'
        ? (site.branding?.footerLogo ?? site.branding?.logo)
        : site.branding?.logo;
const showName = logo?.showName ?? true;
const highlight = name === 'Sproutsite' ? 'site' : undefined;
const highlightStart = highlight ? name.indexOf(highlight) : -1;
const hasHighlight = highlightStart >= 0 && highlight !== undefined;
const nameBeforeHighlight = hasHighlight ? name.slice(0, highlightStart) : name;
const nameAfterHighlight = hasHighlight
    ? name.slice(highlightStart + highlight.length)
    : undefined;
---

<span class:list={['ss-brand-logo', { 'ss-brand-logo--custom': logo }]}>
    {logo && (
        <span
            class="ss-brand-logo__image"
            role={showName ? undefined : 'img'}
            aria-label={showName ? undefined : name}
            style={{
                '--ss-logo-width': `${logo.width / 16}rem`,
                '--ss-logo-ratio': `${logo.width} / ${logo.height}`,
            }}
        >
            <img
                class="ss-brand-logo__light"
                src={withBase(logo.src, site.base)}
                width={logo.width}
                height={logo.height}
                alt=""
                aria-hidden="true"
            />
            {logo.srcOnDark && (
                <img
                    class="ss-brand-logo__dark"
                    src={withBase(logo.srcOnDark, site.base)}
                    width={logo.width}
                    height={logo.height}
                    alt=""
                    aria-hidden="true"
                />
            )}
        </span>
    )}
    {showName && (
        <span class="ss-brand-logo__name">
            {nameBeforeHighlight}
            {hasHighlight && (
                <span class="ss-brand-logo__highlight">{highlight}</span>
            )}
            {nameAfterHighlight}
        </span>
    )}
</span>
