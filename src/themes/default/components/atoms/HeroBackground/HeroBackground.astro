---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { publicImageMetadata } from '../../../../../lib/sproutsite/public-assets.js';
import {
    validatePublicBackground,
    validatePublicBackgroundImage,
} from '../../../../../lib/sproutsite/hero-background.js';
import { withBase } from '../../../../../lib/sproutsite/urls.js';
import type { BackgroundPositionSettings } from '../../../../../lib/sproutsite/types.js';

interface Props extends BackgroundPositionSettings {
    source: ImageMetadata | string;
    base: string;
}
const {
    source,
    base,
    'background-position': position,
    'background-position-mobile': mobilePosition,
} = Astro.props;
if (typeof source === 'string')
    validatePublicBackground(source, 'hero background');
if (typeof source === 'string') await validatePublicBackgroundImage(source);
const image =
    typeof source === 'string'
        ? {
              ...(await publicImageMetadata(source)),
              src: withBase(source, base),
          }
        : source;
const svg = image.format === 'svg';
const classes = [
    'ss-hero-background',
    {
        'ss-hero-background--svg': svg,
        'ss-hero-background--positioned': Boolean(position || mobilePosition),
    },
];
const positionStyle = {
    '--ss-background-position': position,
    '--ss-background-position-mobile': mobilePosition,
};
---

{typeof source === 'string' || svg ? (
    <img
        class:list={classes}
        style={positionStyle}
        src={image.src}
        width={image.width}
        height={image.height}
        alt=""
        loading="eager"
        decoding="async"
        aria-hidden="true"
    />
) : (
    <Image
        class:list={classes}
        style={positionStyle}
        src={source}
        alt=""
        format="webp"
        quality={82}
        loading="eager"
        decoding="async"
        aria-hidden="true"
    />
)}
