---
import type { ComponentProps } from 'astro/types';
import Icon from '../../atoms/Icon/Icon.astro';
import { isHexColor } from '../../../../../lib/sproutsite/colors.js';

/** A compact benefit with a decorative icon, heading, and Markdown description. */
interface Props {
    icon: ComponentProps<typeof Icon>['name'];
    title: string;
    layout?: 'horizontal' | 'vertical' | 'card';
    iconSize?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
    /** Explicit background: icon box, or entire surface for layout card. */
    backgroundColor?: `#${string}`;
    variant?: 'soft' | 'solid' | 'plain';
    color?:
        | 'primary'
        | 'secondary'
        | 'accent'
        | 'neutral'
        | 'info'
        | 'success'
        | 'warning'
        | 'error'
        | `#${string}`;
    headingLevel?: 2 | 3 | 4 | 5 | 6;
}

const {
    icon,
    title,
    layout = 'horizontal',
    iconSize = 'md',
    variant = 'soft',
    color = 'primary',
    backgroundColor,
    headingLevel = 3,
} = Astro.props;
if (backgroundColor !== undefined && !isHexColor(backgroundColor))
    throw new Error(
        'Sproutsite Feature backgroundColor must be a CSS hex color.',
    );
const iconPixels = { xs: 14, sm: 21, md: 28, lg: 42, xl: 56 } as const;
if (!Object.hasOwn(iconPixels, iconSize))
    throw new Error(
        'Sproutsite Feature iconSize must be xs, sm, md, lg, or xl.',
    );
if (!['horizontal', 'vertical', 'card'].includes(layout))
    throw new Error(
        'Sproutsite Feature layout must be horizontal, vertical, or card.',
    );
if (!title?.trim())
    throw new Error('Sproutsite Feature requires a non-empty title.');
if (![2, 3, 4, 5, 6].includes(headingLevel))
    throw new Error(
        'Sproutsite Feature headingLevel must be 2, 3, 4, 5, or 6.',
    );
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
const customColor = isHexColor(color);
if (
    !customColor &&
    ![
        'primary',
        'secondary',
        'accent',
        'neutral',
        'info',
        'success',
        'warning',
        'error',
    ].includes(color)
) {
    throw new Error(
        'Sproutsite Feature color must be a semantic theme color or a valid hexadecimal CSS color.',
    );
}
---

<div
    class:list={[
        'ss-feature',
        'not-prose',
        `ss-feature--${layout}`,
        `ss-feature--icon-${iconSize}`,
        customColor
            ? 'ss-feature--custom'
            : layout !== 'card' && `ss-feature--${variant}`,
        !customColor && `ss-feature--${color}`,
        backgroundColor && layout !== 'card' && 'ss-feature--custom-background',
    ]}
    style={
        [
            customColor && `--ss-feature-color: ${color};`,
            backgroundColor && `--ss-feature-background: ${backgroundColor};`,
        ]
            .filter(Boolean)
            .join(' ') || undefined
    }
>
    <span class="ss-feature__icon" aria-hidden="true">
        <Icon name={icon} size={iconPixels[iconSize]} />
    </span>
    <div class="ss-feature__content">
        <Heading class="ss-feature__title">{title.trim()}</Heading>
        <div class="ss-feature__description">
            <slot />
        </div>
    </div>
</div>
