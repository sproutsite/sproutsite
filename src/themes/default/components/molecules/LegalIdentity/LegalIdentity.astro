---
import { loadLegalIdentity } from '../../../../../lib/sproutsite/legal-identity.js';
import { loadSiteConfig } from '../../../../../lib/sproutsite/site-config.js';
import { externalLinkAttributes } from '../../../../../lib/sproutsite/urls.js';
import Column from '../../layout/Column/Column.astro';
import Columns from '../../layout/Columns/Columns.astro';
import Feature from '../Feature/Feature.astro';
import Alert from '../Alert/Alert.astro';

interface Props {
    part?: 'contact' | 'name' | 'email' | 'controller';
}
const { part = 'contact' } = Astro.props;
if (!['contact', 'name', 'email', 'controller'].includes(part))
    throw new Error(
        'LegalIdentity part must be contact, name, email or controller.',
    );
const { values, placeholder } = loadLegalIdentity(import.meta.env.PROD);
const german = Astro.currentLocale === 'de';
const site = loadSiteConfig(german ? 'de' : 'en');
const country =
    new Intl.DisplayNames([german ? 'de' : 'en'], { type: 'region' }).of(
        values.LEGAL_COUNTRY,
    ) ?? values.LEGAL_COUNTRY;
---

{part === 'name' ? (
    values.LEGAL_NAME
) : part === 'email' ? (
    <a href={`mailto:${values.LEGAL_EMAIL}`}>{values.LEGAL_EMAIL}</a>
) : (
    <div class="ss-legal-identity">
        {placeholder && (
            <Alert variant="info">
                {german
                    ? 'Vorschau mit Beispieldaten: Die Betreiberangaben in der lokalen .env fehlen, sind unvollständig oder enthalten noch Musterwerte.'
                    : 'Preview with example data: Operator details in the local .env are missing, incomplete or still contain example values.'}
            </Alert>
        )}
        <Columns>
            <Column span={6}>
                <Feature
                    icon="MapPin"
                    title={german ? 'Postanschrift' : 'Postal address'}
                    layout="card"
                    color="primary"
                >
                    <address>
                        <strong>{values.LEGAL_NAME}</strong>
                        <span>{values.LEGAL_STREET}</span>
                        <span>
                            {values.LEGAL_POSTAL_CODE} {values.LEGAL_CITY}
                        </span>
                        <span>{country}</span>
                    </address>
                </Feature>
            </Column>
            <Column span={6}>
                <Feature
                    icon="Mail"
                    title={german ? 'Kontakt' : 'Contact'}
                    layout="card"
                    color="secondary"
                >
                    <p>
                        <strong>{german ? 'E-Mail' : 'Email'}</strong>
                        <br />
                        <a href={`mailto:${values.LEGAL_EMAIL}`}>
                            {values.LEGAL_EMAIL}
                        </a>
                    </p>
                    {part !== 'controller' && (
                        <p>
                            <strong>LinkedIn</strong>
                            <br />
                            <a
                                href={values.LEGAL_LINKEDIN}
                                {...externalLinkAttributes(
                                    values.LEGAL_LINKEDIN,
                                    site,
                                )}
                            >
                                {values.LEGAL_NAME}{' '}
                                {german ? 'auf LinkedIn' : 'on LinkedIn'}
                            </a>
                        </p>
                    )}
                </Feature>
            </Column>
        </Columns>
    </div>
)}
