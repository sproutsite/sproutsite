---
import { t } from '../../../i18n/index.js';
const locale = Astro.currentLocale === 'de' ? 'de' : 'en';
const kinds = [
    'colors',
    'type',
    'spacing',
    'radius',
    'shadow',
    'focus',
] as const;
type SampleKind = (typeof kinds)[number];

interface Props {
    kind: SampleKind;
}

const { kind } = Astro.props;
if (!kinds.includes(kind))
    throw new Error(
        `FoundationSample kind must be one of: ${kinds.join(', ')}.`,
    );

const colors = [
    ['base-100', t(locale, 'foundationDefault')],
    ['base-200', t(locale, 'foundationMuted')],
    ['base-300', t(locale, 'foundationBorder')],
    ['base-content', t(locale, 'foundationText')],
    ['primary', t(locale, 'foundationPrimary')],
    ['secondary', t(locale, 'foundationSecondary')],
    ['accent', t(locale, 'foundationAccent')],
    ['neutral', t(locale, 'foundationNeutral')],
    ['info', t(locale, 'foundationInfo')],
    ['success', t(locale, 'foundationSuccess')],
    ['warning', t(locale, 'foundationWarning')],
    ['error', t(locale, 'foundationError')],
] as const;
const spaces = [
    ['1', '0.25rem'],
    ['2', '0.5rem'],
    ['4', '1rem'],
    ['6', '1.5rem'],
    ['8', '2rem'],
] as const;
const radii = [
    ['none', t(locale, 'foundationSquare'), '0'],
    ['field', t(locale, 'foundationFields'), '--radius-field'],
    ['box', t(locale, 'foundationBoxes'), '--radius-box'],
] as const;
const shadows = [
    ['none', t(locale, 'foundationNoShadow'), 'none'],
    ['sm', t(locale, 'foundationSmall'), '--shadow-sm'],
    ['soft', t(locale, 'foundationSoft'), '--shadow-soft'],
    ['raised', t(locale, 'foundationRaised'), '--shadow-raised'],
] as const;
---

<div
    class:list={[
        'ss-foundation-sample',
        `ss-foundation-sample--${kind}`,
        'not-prose',
    ]}
>
    {kind === 'colors' && (
        <ul class="ss-foundation-sample__palette">
            {colors.map(([name, label]) => (
                <li class="ss-foundation-sample__color">
                    <div
                        class:list={[
                            'ss-foundation-sample__swatch',
                            `ss-foundation-sample__swatch--${name}`,
                        ]}
                        aria-hidden="true"
                    />
                    <span>{label}</span>
                    <code>--color-{name}</code>
                </li>
            ))}
        </ul>
    )}
    {kind === 'type' && (
        <div class="ss-foundation-sample__type">
            <p class="ss-foundation-sample__label">
                {t(locale, 'foundationDisplayLabel')}
            </p>
            <p class="ss-foundation-sample__display">
                {t(locale, 'foundationDisplay')}
            </p>
            <p class="ss-foundation-sample__label">
                {t(locale, 'foundationHeadingLabel')}
            </p>
            <p class="ss-foundation-sample__heading">
                {t(locale, 'foundationHeading')}
            </p>
            <p class="ss-foundation-sample__label">
                {t(locale, 'foundationBodyLabel')}
            </p>
            <p class="ss-foundation-sample__body">
                {t(locale, 'foundationBody')}
            </p>
        </div>
    )}
    {kind === 'spacing' && (
        <ul class="ss-foundation-sample__spaces">
            {spaces.map(([step, size]) => (
                <li class="ss-foundation-sample__space-row">
                    <span>
                        {locale === 'de' ? size.replace('.', ',') : size}
                    </span>
                    <div class="ss-foundation-sample__track" aria-hidden="true">
                        <span
                            class:list={[
                                'ss-foundation-sample__space',
                                `ss-foundation-sample__space--${step}`,
                            ]}
                        />
                    </div>
                </li>
            ))}
        </ul>
    )}
    {kind === 'radius' && (
        <ul class="ss-foundation-sample__tiles">
            {radii.map(([name, label, token]) => (
                <li class="ss-foundation-sample__tile">
                    <div
                        class:list={[
                            'ss-foundation-sample__shape',
                            `ss-foundation-sample__shape--${name}`,
                        ]}
                        aria-hidden="true"
                    />
                    <span>{label}</span>
                    <code>{token}</code>
                </li>
            ))}
        </ul>
    )}
    {kind === 'shadow' && (
        <ul class="ss-foundation-sample__tiles">
            {shadows.map(([name, label, token]) => (
                <li class="ss-foundation-sample__tile">
                    <div
                        class:list={[
                            'ss-foundation-sample__elevation',
                            `ss-foundation-sample__elevation--${name}`,
                        ]}
                        aria-hidden="true"
                    />
                    <span>{label}</span>
                    <code>{token}</code>
                </li>
            ))}
        </ul>
    )}
    {kind === 'focus' && (
        <div class="ss-foundation-sample__focus-area">
            <p>{t(locale, 'foundationFocus')}</p>
            <a class="ss-foundation-sample__focus" href="#main-content">
                {t(locale, 'foundationFocusLink')}
            </a>
        </div>
    )}
</div>
