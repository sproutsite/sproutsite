---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import {
    normalizeCardBadges,
    type CardBadge,
} from '../../../../../lib/sproutsite/badges.js';
import Badge from '#sproutsite/badge';

type CardShadow = 'none' | 'sm' | 'md' | 'lg' | 'xl';

/** A reusable content card with an optional optimized local image and default content slot. */
interface Props {
    /** Imported Astro image metadata for the optional figure. */
    image?: ImageMetadata;
    /** Required accessible alternative text when image is set. */
    imageAlt?: string;
    /** Elevation treatment for the card. */
    shadow?: CardShadow;
    /** One status label or a list, displayed at the bottom right of the media area. */
    badges?: CardBadge | readonly CardBadge[];
}

const { image, imageAlt, shadow = 'sm', badges } = Astro.props;
const labels = normalizeCardBadges(badges);
const hintPrefix = labels.some((label) => label.hover)
    ? `ss-card-hint-${crypto.randomUUID()}`
    : '';
const shadowClasses: Record<CardShadow, string> = {
    none: 'shadow-none',
    sm: 'shadow-sm',
    md: 'shadow-md',
    lg: 'shadow-lg',
    xl: 'shadow-xl',
};
if (Boolean(image) !== Boolean(imageAlt))
    throw new Error(
        'Sproutsite Card requires image and imageAlt together, or neither prop.',
    );
---

<article
    class:list={[
        'ss-card',
        'card',
        'bg-base-100',
        shadowClasses[shadow],
        'not-prose',
    ]}
>
    {(image || labels.length > 0) && (
        <figure
            class:list={[
                'ss-card__figure',
                { 'ss-card__figure--placeholder': !image },
            ]}
        >
            {image && (
                <Image
                    src={image}
                    alt={imageAlt!}
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                    class="ss-card__image"
                />
            )}
            {labels.length > 0 && (
                <ul class="ss-card__badges">
                    {labels.map((label, index) => (
                        <li>
                            {label.hover ? (
                                <span
                                    class="ss-card__badge-hint"
                                    tabindex="0"
                                    aria-describedby={`${hintPrefix}-${index}`}
                                >
                                    <Badge
                                        variant={label.variant}
                                        style={label.style}
                                    >
                                        {label.text}
                                    </Badge>
                                    <span
                                        class="ss-card__badge-tooltip"
                                        id={`${hintPrefix}-${index}`}
                                        role="tooltip"
                                        popover="manual"
                                        hidden
                                    >
                                        {label.hover}
                                    </span>
                                </span>
                            ) : (
                                <Badge
                                    variant={label.variant}
                                    style={label.style}
                                >
                                    {label.text}
                                </Badge>
                            )}
                        </li>
                    ))}
                </ul>
            )}
        </figure>
    )}
    <div class="ss-card__body card-body">
        {/* @slot Markdown-compatible card body content. */}
        <slot />
    </div>
</article>

<script>
    import './Card';
</script>
