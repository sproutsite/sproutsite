---
import Eyebrow from '#sproutsite/eyebrow';
import HeroBackground from '#sproutsite/herobackground';
import type { SiteConfig } from '../../../../../lib/sproutsite/types.js';
import { isSvgHeroImage } from '../../../../../lib/sproutsite/hero-background.js';

interface Props {
    title: string;
    site: SiteConfig;
    classes: string[];
    eyebrow?: string;
    description?: string;
    variant?: 'compact' | 'hero';
}

const {
    title,
    site,
    classes,
    eyebrow,
    description,
    variant = 'compact',
} = Astro.props;
---

<section
    class:list={[
        'tone-brand',
        'ss-hero',
        'ss-hero--small',
        'ss-page-title',
        `ss-page-title--${variant}`,
        {
            'ss-hero--has-background-image': Boolean(
                site.hero['background-image'],
            ),
            'ss-hero--background-svg': isSvgHeroImage(
                site.hero['background-image'],
            ),
        },
        ...classes,
    ]}
    aria-labelledby="page-title"
>
    {site.hero['background-image'] && (
        <HeroBackground
            source={site.hero['background-image']}
            base={site.base}
            background-position={site.hero['background-position']}
            background-position-mobile={site.hero['background-position-mobile']}
        />
    )}
    <div class="ss-hero__inner ss-page-title__inner site-shell">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <h1 id="page-title" class="ss-hero__title ss-page-title__title">
            {title}
        </h1>
        {description && <p class="ss-page-title__description">{description}</p>}
    </div>
</section>
