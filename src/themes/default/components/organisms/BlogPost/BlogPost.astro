---
import type { CollectionEntry } from 'astro:content';
import type { AssembledPage } from '../../../../../lib/sproutsite/pages.js';
import type { SiteConfig } from '../../../../../lib/sproutsite/types.js';
import Hero from '#sproutsite/hero';
import Section from '#sproutsite/section';
import { externalLinkAttributes } from '../../../../../lib/sproutsite/urls.js';

type BlogPage = CollectionEntry<'blogPages'>;
type BlogDocument = CollectionEntry<'blogDocuments'>;
type RenderedContent = Awaited<
    ReturnType<typeof import('astro:content').render>
>['Content'];

interface Props {
    post: AssembledPage<BlogPage, BlogDocument>;
    site: SiteConfig;
    HeroContent: RenderedContent;
    sections: { section: BlogDocument; Content: RenderedContent }[];
}

const { post, site, HeroContent, sections } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat(site.i18n.locale, {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
});
---

<div class="ss-blog-post">
    <Hero hero={post.hero!} site={site} Content={HeroContent}>
        <span slot="meta" class="ss-hero__meta">
            <time datetime={post.entry.data.pubDate.toISOString()}>
                {dateFormatter.format(post.entry.data.pubDate)}
            </time>
            {post.entry.data.author && (
                <>
                    {' · '}
                    {post.entry.data.author.url ? (
                        <a
                            href={post.entry.data.author.url}
                            {...externalLinkAttributes(
                                post.entry.data.author.url,
                                site,
                            )}
                        >
                            {post.entry.data.author.name}
                        </a>
                    ) : (
                        post.entry.data.author.name
                    )}
                </>
            )}
        </span>
    </Hero>
    {sections.map(({ section, Content }) => (
        <Section section={section} Content={Content} />
    ))}
</div>
