---
import BrandLogo from '../../atoms/BrandLogo/BrandLogo.astro';
import Button from '../../atoms/Button/Button.astro';
import Icon from '../../atoms/Icon/Icon.astro';
import LanguageSwitcher from '../../molecules/LanguageSwitcher/LanguageSwitcher.astro';
import type { ComponentProps } from 'astro/types';
import { t } from '../../../i18n/index.js';
import type { Link, SiteConfig } from '../../../../../lib/sproutsite/types.js';
import {
    contentHref,
    isExternalWebLink,
} from '../../../../../lib/sproutsite/urls.js';

interface Props {
    site: SiteConfig;
    route: string;
}
const { site, route } = Astro.props;
const isActive = (link: Link) => link.href === route;
---

<header class="ss-header">
    <div class="ss-header__inner site-shell">
        <a class="ss-header__brand" href={contentHref('/', site)}>
            <BrandLogo name={site.name} />
        </a>
        <nav
            class="ss-header__nav"
            aria-label={t(
                site.language === 'de' ? 'de' : 'en',
                'primaryNavigation',
            )}
        >
            <ul class="ss-header__links">
                {site.header.links.map((link) => {
                    if (link.type === 'language-switcher') {
                        return (
                            <li>
                                <LanguageSwitcher site={site} route={route} />
                            </li>
                        );
                    }
                    if (link.type === 'separator') {
                        return (
                            <li
                                class="ss-header__separator"
                                aria-hidden="true"
                            />
                        );
                    }
                    const external = isExternalWebLink(link.href, site.url);
                    // Icon validates configured names against Lucide at render time.
                    const icon = link.icon as
                        ComponentProps<typeof Icon>['name'] | undefined;
                    if (link.type === 'cta') {
                        return (
                            <li class="ss-header__cta">
                                <Button
                                    href={link.href}
                                    variant={link.variant}
                                    size="md"
                                    target={external ? '_blank' : undefined}
                                    rel={
                                        external
                                            ? 'noopener noreferrer'
                                            : undefined
                                    }
                                    aria-current={
                                        isActive(link) ? 'page' : undefined
                                    }
                                >
                                    {icon && <Icon name={icon} size={20} />}
                                    {link.label}
                                </Button>
                            </li>
                        );
                    }
                    return (
                        <li>
                            <a
                                class="ss-header__link btn btn-ghost btn-sm"
                                href={contentHref(link.href, site)}
                                target={external ? '_blank' : undefined}
                                rel={
                                    external ? 'noopener noreferrer' : undefined
                                }
                                aria-current={
                                    isActive(link) ? 'page' : undefined
                                }
                            >
                                {icon && <Icon name={icon} size={20} />}
                                {link.label}
                            </a>
                        </li>
                    );
                })}
            </ul>
        </nav>
    </div>
</header>

<script>
    const scrollThreshold = 6;
    const header = document.querySelector<HTMLElement>('.ss-header');

    if (header) {
        const updateHeaderState = () => {
            header.classList.toggle(
                'ss-header--scrolled',
                window.scrollY >= scrollThreshold,
            );
        };

        updateHeaderState();
        window.addEventListener('scroll', updateHeaderState, {
            passive: true,
        });
    }
</script>
