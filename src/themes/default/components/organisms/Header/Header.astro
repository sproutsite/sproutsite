---
import BrandLogo from '../../atoms/BrandLogo/BrandLogo.astro';
import Button from '../../atoms/Button/Button.astro';
import Icon from '../../atoms/Icon/Icon.astro';
import LanguageSwitcher from '../../molecules/LanguageSwitcher/LanguageSwitcher.astro';
import type { ComponentProps } from 'astro/types';
import { t } from '../../../i18n/index.js';
import type { SiteConfig } from '../../../../../lib/sproutsite/types.js';
import { navigationCurrent } from './navigation.js';
import {
    contentHref,
    externalLinkAttributes,
} from '../../../../../lib/sproutsite/urls.js';

interface Props {
    site: SiteConfig;
    route: string;
}
const { site, route } = Astro.props;
const language = site.i18n.locale === 'de' ? 'de' : 'en';
const hasLanguageSwitcher = site.header.links.some(
    (link) => link.type === 'language-switcher',
);
---

<header class="ss-header">
    <div class="ss-header__inner site-shell">
        <a class="ss-header__brand" href={contentHref('/', site)}>
            <BrandLogo site={site} />
        </a>
        <div class="ss-header__mobile-tools">
            {hasLanguageSwitcher && (
                <>
                    <LanguageSwitcher site={site} route={route} />
                    <span
                        class="ss-header__mobile-divider"
                        aria-hidden="true"
                    />
                </>
            )}
            <button
                type="button"
                class="ss-header__menu-toggle"
                aria-label={t(language, 'openMenu')}
                aria-controls="ss-mobile-menu"
                aria-expanded="false"
            >
                <Icon name="Menu" size={28} />
            </button>
        </div>
        <nav
            class="ss-header__nav"
            aria-label={t(
                site.i18n.locale === 'de' ? 'de' : 'en',
                'primaryNavigation',
            )}
        >
            <ul class="ss-header__links">
                {site.header.links.map((link) => {
                    if (link.type === 'language-switcher') {
                        return (
                            <li>
                                <LanguageSwitcher site={site} route={route} />
                            </li>
                        );
                    }
                    if (link.type === 'separator') {
                        return (
                            <li
                                class="ss-header__separator"
                                aria-hidden="true"
                            />
                        );
                    }
                    const externalAttributes = externalLinkAttributes(
                        link.href,
                        site,
                    );
                    // Icon validates configured names against Lucide at render time.
                    const icon = link.icon as
                        ComponentProps<typeof Icon>['name'] | undefined;
                    if (link.type === 'cta') {
                        return (
                            <li class="ss-header__cta">
                                <Button
                                    href={link.href}
                                    variant={link.variant}
                                    size="md"
                                    target={externalAttributes.target}
                                    rel={externalAttributes.rel}
                                    aria-current={navigationCurrent(
                                        link.href,
                                        route,
                                    )}
                                >
                                    {icon && <Icon name={icon} size={20} />}
                                    {link.label}
                                </Button>
                            </li>
                        );
                    }
                    return (
                        <li>
                            <a
                                class="ss-header__link btn btn-ghost btn-sm"
                                href={contentHref(link.href, site)}
                                {...externalAttributes}
                                aria-current={navigationCurrent(
                                    link.href,
                                    route,
                                )}
                            >
                                {icon && <Icon name={icon} size={20} />}
                                {link.label}
                            </a>
                        </li>
                    );
                })}
            </ul>
        </nav>
    </div>
    <dialog
        id="ss-mobile-menu"
        class="ss-header__dialog"
        aria-label={t(language, 'primaryNavigation')}
    >
        <div class="ss-header__dialog-top site-shell">
            <a class="ss-header__dialog-brand" href={contentHref('/', site)}>
                <BrandLogo site={site} />
            </a>
            <button
                type="button"
                class="ss-header__dialog-close"
                aria-label={t(language, 'closeMenu')}
                autofocus
            >
                <Icon name="X" size={32} />
            </button>
        </div>
        <div class="ss-header__dialog-content site-shell" />
    </dialog>
</header>

<script>
    const scrollThreshold = 6;
    const header = document.querySelector<HTMLElement>('.ss-header');

    if (header) {
        const navigation = header.querySelector<HTMLElement>('.ss-header__nav');
        const dialog =
            header.querySelector<HTMLDialogElement>('.ss-header__dialog');
        const dialogContent = header.querySelector<HTMLElement>(
            '.ss-header__dialog-content',
        );
        const toggle = header.querySelector<HTMLButtonElement>(
            '.ss-header__menu-toggle',
        );
        const close = header.querySelector<HTMLButtonElement>(
            '.ss-header__dialog-close',
        );
        if (navigation && dialog && dialogContent && toggle && close) {
            const home = navigation.parentElement!;
            const mobile = window.matchMedia('(max-width: 71.999rem)');
            let previousOverflow = '';
            const closeLanguageMenus = () =>
                header
                    .querySelectorAll<HTMLDetailsElement>(
                        '.ss-language-switcher',
                    )
                    .forEach((menu) => {
                        menu.open = false;
                    });
            const syncNavigation = () => {
                if (dialog.open) dialog.close();
                closeLanguageMenus();
                (mobile.matches ? dialogContent : home).append(navigation);
            };
            toggle.addEventListener('click', () => {
                if (!mobile.matches || dialog.open) return;
                closeLanguageMenus();
                previousOverflow = document.documentElement.style.overflow;
                dialog.showModal();
                document.documentElement.style.overflow = 'hidden';
                toggle.setAttribute('aria-expanded', 'true');
            });
            close.addEventListener('click', () => dialog.close());
            dialog.addEventListener('close', () => {
                document.documentElement.style.overflow = previousOverflow;
                toggle.setAttribute('aria-expanded', 'false');
                closeLanguageMenus();
                if (mobile.matches) toggle.focus();
                else
                    header
                        .querySelector<HTMLAnchorElement>('.ss-header__brand')
                        ?.focus({ preventScroll: true });
            });
            navigation.addEventListener('click', (event) => {
                if (
                    event.target instanceof Element &&
                    event.target.closest('a') &&
                    dialog.open
                )
                    dialog.close();
            });
            mobile.addEventListener('change', syncNavigation);
            header.dataset.mobileEnhanced = '';
            syncNavigation();
        }
        const updateHeaderState = () => {
            header.classList.toggle(
                'ss-header--scrolled',
                window.scrollY >= scrollThreshold,
            );
        };

        updateHeaderState();
        window.addEventListener('scroll', updateHeaderState, {
            passive: true,
        });
    }
</script>
