---
import { isHexColor } from '../../../../../lib/sproutsite/colors.js';

const gapSizes = ['xs', 'sm', 'md', 'lg', 'xl'] as const;
type GapSize = (typeof gapSizes)[number];

interface Props {
    /** Draw separators between adjacent columns, horizontal when stacked. */
    divider?: boolean;
    /** Optional CSS hex color; otherwise use the theme's subtle gray. */
    dividerColor?: `#${string}`;
    /** Named spacing preset; md is the default (6rem total gap). */
    dividerGap?: GapSize;
    /** Optional preset for stacked columns below 64rem; defaults to half the dividerGap spacing. */
    dividerGapMobile?: GapSize;
}

const {
    divider = false,
    dividerColor,
    dividerGap = 'md',
    dividerGapMobile,
} = Astro.props;
if (
    typeof divider !== 'boolean' ||
    (dividerColor !== undefined && !isHexColor(dividerColor)) ||
    !gapSizes.includes(dividerGap) ||
    (dividerGapMobile !== undefined && !gapSizes.includes(dividerGapMobile))
)
    throw new Error(
        'Sproutsite Columns: divider must be boolean, dividerColor must be a CSS hex color, and dividerGap and dividerGapMobile must be xs, sm, md, lg, or xl.',
    );
---

<div
    class:list={[
        'ss-columns',
        divider && 'ss-columns--divider',
        divider && `ss-columns--divider-gap-${dividerGap}`,
        divider &&
            dividerGapMobile &&
            `ss-columns--divider-gap-mobile-${dividerGapMobile}`,
    ]}
    style={
        dividerColor
            ? `--ss-columns-divider-color: ${dividerColor};`
            : undefined
    }
>
    <slot />
</div>

<script>
    // CSS Grid wraps arbitrary spans. Measure rows rather than assuming a fixed
    // number of columns, so separators never appear at the start of a new row.
    document
        .querySelectorAll<HTMLElement>('.ss-columns--divider')
        .forEach((grid) => {
            const columns = Array.from(grid.children).filter(
                (child): child is HTMLElement =>
                    child instanceof HTMLElement &&
                    child.classList.contains('ss-column'),
            );
            const update = () => {
                const positions = columns.map(
                    (column) => column.getBoundingClientRect().top,
                );
                columns.forEach((column, index) => {
                    column.toggleAttribute(
                        'data-divider-before',
                        index > 0 &&
                            Math.abs(
                                positions[index]! - positions[index - 1]!,
                            ) < 1,
                    );
                });
            };
            const observer = new ResizeObserver(update);
            observer.observe(grid);
            columns.forEach((column) => observer.observe(column));
            update();
        });
</script>
