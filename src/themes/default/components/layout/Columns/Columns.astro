---
import { isHexColor } from '../../../../../lib/sproutsite/colors.js';
import type { ComponentProps } from 'astro/types';
import Icon from '#sproutsite/icon';

const gapSizes = ['xs', 'sm', 'md', 'lg', 'xl'] as const;
type GapSize = (typeof gapSizes)[number];

interface Props {
    /** Shared spacing preset; unseparated columns default to md (2rem). */
    gap?: GapSize;
    /** Optional independent spacing preset below 64rem. */
    gapMobile?: GapSize;
    /** Draw separators between adjacent columns, horizontal when stacked. */
    divider?: boolean;
    /** Decorative Lucide icon between columns; takes precedence over divider. */
    separator?: ComponentProps<typeof Icon>['name'];
    /** Desktop alignment: column center or the first vertical Feature icon. */
    separatorAlign?: 'centered' | 'top';
    /** Optional CSS hex color; otherwise use the theme's subtle gray. */
    dividerColor?: `#${string}`;
    /** Named spacing preset; md is the default (6rem total gap). */
    dividerGap?: GapSize;
    /** Optional preset for stacked columns below 64rem; defaults to half the dividerGap spacing. */
    dividerGapMobile?: GapSize;
}

const {
    gap,
    gapMobile,
    divider = false,
    separator,
    separatorAlign = 'centered',
    dividerColor,
    dividerGap = 'md',
    dividerGapMobile,
} = Astro.props;
if (!['centered', 'top'].includes(separatorAlign))
    throw new Error(
        'Sproutsite Columns separatorAlign must be centered or top.',
    );
if (
    separator !== undefined &&
    (typeof separator !== 'string' || !/^[A-Z][A-Za-z0-9]*$/.test(separator))
)
    throw new Error(
        'Sproutsite Columns separator must be a canonical Lucide name, such as MoveRight or Plus.',
    );
const separated = divider || separator !== undefined;
const customGap = gap !== undefined || gapMobile !== undefined;
if (
    typeof divider !== 'boolean' ||
    (gap !== undefined && !gapSizes.includes(gap)) ||
    (gapMobile !== undefined && !gapSizes.includes(gapMobile)) ||
    (dividerColor !== undefined && !isHexColor(dividerColor)) ||
    !gapSizes.includes(dividerGap) ||
    (dividerGapMobile !== undefined && !gapSizes.includes(dividerGapMobile))
)
    throw new Error(
        'Sproutsite Columns: divider must be boolean, dividerColor must be a CSS hex color, and gap, gapMobile, dividerGap, and dividerGapMobile must be xs, sm, md, lg, or xl.',
    );
---

<div
    class:list={[
        'ss-columns',
        customGap && !separated && 'ss-columns--spaced',
        gap && `ss-columns--gap-${gap}`,
        gapMobile && `ss-columns--gap-mobile-${gapMobile}`,
        divider && !separator && 'ss-columns--divider',
        separator && 'ss-columns--separator',
        separator && `ss-columns--separator-${separatorAlign}`,
        separated && `ss-columns--divider-gap-${dividerGap}`,
        separated &&
            dividerGapMobile &&
            `ss-columns--divider-gap-mobile-${dividerGapMobile}`,
    ]}
    style={
        dividerColor
            ? `--ss-columns-divider-color: ${dividerColor}; --ss-columns-separator-color: ${dividerColor};`
            : undefined
    }
>
    <slot />
    {separator && (
        <template data-columns-separator>
            <span class="ss-columns__separator" aria-hidden="true">
                <Icon name={separator} size={24} />
            </span>
        </template>
    )}
</div>

<script>
    // Layouts wrap arbitrary spans. Measure rows rather than assuming a fixed
    // number of columns, so separators never appear at the start of a new row.
    document
        .querySelectorAll<HTMLElement>(
            '.ss-columns--divider, .ss-columns--separator',
        )
        .forEach((grid) => {
            const columns = Array.from(grid.children).filter(
                (child): child is HTMLElement =>
                    child instanceof HTMLElement &&
                    child.classList.contains('ss-column'),
            );
            const template = grid.querySelector<HTMLTemplateElement>(
                ':scope > template[data-columns-separator]',
            );
            const separators = template
                ? columns.slice(1).map(() => {
                      const element =
                          template.content.firstElementChild!.cloneNode(
                              true,
                          ) as HTMLElement;
                      grid.append(element);
                      return element;
                  })
                : [];
            const update = () => {
                const positions = columns.map((column) =>
                    column.getBoundingClientRect(),
                );
                const bounds = grid.getBoundingClientRect();
                const desktop = window.matchMedia('(min-width: 64rem)').matches;
                const topAligned = grid.classList.contains(
                    'ss-columns--separator-top',
                );
                const rootFontSize = parseFloat(
                    getComputedStyle(document.documentElement).fontSize,
                );
                columns.forEach((column, index) => {
                    const current = positions[index]!;
                    const previous = positions[index - 1];
                    const sameRow =
                        previous !== undefined &&
                        Math.abs(current.top - previous.top) < 1;
                    column.toggleAttribute('data-divider-before', sameRow);
                    const separator = separators[index - 1];
                    if (!separator || !previous) return;
                    separator.hidden = desktop && !sameRow;
                    const featureIcon = topAligned
                        ? column
                              .querySelector<HTMLElement>(
                                  ':scope > .ss-feature--vertical > .ss-feature__icon',
                              )
                              ?.getBoundingClientRect()
                        : undefined;
                    const desktopY = topAligned
                        ? featureIcon
                            ? (featureIcon.top + featureIcon.bottom) / 2
                            : current.top + 1.75 * rootFontSize
                        : (current.top + current.bottom) / 2;
                    separator.style.left = `${(desktop ? (previous.right + current.left) / 2 : (current.left + current.right) / 2) - bounds.left}px`;
                    separator.style.top = `${(desktop ? desktopY : (previous.bottom + current.top) / 2) - bounds.top}px`;
                });
            };
            const observer = new ResizeObserver(update);
            observer.observe(grid);
            columns.forEach((column) => observer.observe(column));
            update();
        });
</script>
