# Copy to .env and replace the example identity before building.
# These values are rendered publicly on the legal-notice pages.
# Never commit .env. Do not prefix these variables with PUBLIC_.
LEGAL_NAME="Max Mustermann"
LEGAL_STREET="Musterstraße 123"
LEGAL_POSTAL_CODE="12345"
LEGAL_CITY="Musterstadt"
# ISO 3166-1 alpha-2 country code, e.g. DE.
LEGAL_COUNTRY="DE"
LEGAL_EMAIL="kontakt@example.com"
LEGAL_LINKEDIN="https://www.linkedin.com/in/example/"

# Required only for pages using PrivacyInfrastructure.
PRIVACY_HOST_NAME="Example Hosting GmbH"
PRIVACY_HOST_ADDRESS="Musterstraße 1, 12345 Musterstadt, Deutschland"
PRIVACY_HOST_URL="https://hosting.example.com"
PRIVACY_HOST_PRIVACY_URL="https://hosting.example.com/privacy"
PRIVACY_SERVER_CITY="Musterstadt"
PRIVACY_SERVER_COUNTRY="DE"
# Describes actual operation; these values do not configure nginx or Docker.
PRIVACY_LOG_SIZE_LIMIT_MIB="100"
# Leave empty until an actual time-based deletion policy is defined.
PRIVACY_LOG_RETENTION_DAYS=""
# Upper limit for ordinary completed enquiries; implement deletion in the mailbox.
PRIVACY_EMAIL_RETENTION_MONTHS="6"
